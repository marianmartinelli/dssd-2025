# Backend configuration
APP_NAME=ProjectPlanning API
ENVIRONMENT=local
API_PREFIX=/api/v1
DEBUG=true

# JWT
JWT_SECRET_KEY=please_change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Database
DATABASE_URL=postgresql+asyncpg://projectplanning:projectplanning@db:5432/projectplanning

# Bonita BPM (Local Instance)
USE_BONITA=true
BONITA_BASE_URL=http://host.docker.internal:8080
BONITA_API_USERNAME=walter.bates
BONITA_API_PASSWORD=bpm
BONITA_PROCESS_DEFINITION=Registrar Proyecto
BONITA_PROCESS_VERSION=1.0
BONITA_OBSERVATION_PROCESS_DEFINITION=Gestionar Observaciones
BONITA_OBSERVATION_PROCESS_VERSION=1.0
